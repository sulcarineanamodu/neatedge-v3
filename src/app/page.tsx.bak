          >
            <a href="/contact?enquiry=estimate" className="inline-block">
              <Button variant="primary" size="lg">
                Get a Cleaning Estimate
              </Button>
            </a>
            <a href="tel:07886091926" className="inline-block">
              <Button variant="ghost" size="lg">
                Call 07886 091926
              </Button>
            </a>
          </motion.div>
        </motion.div>
