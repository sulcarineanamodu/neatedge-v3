          {/* Editorial asymmetrical service layout */}
          <div className="grid grid-cols-1 md:grid-cols-12 gap-lg md:gap-2xl">
            {/* Large feature: End-of-Tenancy (spans 7 cols on desktop) */}
            <motion.div
