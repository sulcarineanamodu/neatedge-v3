                <div>
                  <p className="text-grey-light text-xs uppercase tracking-wide mb-xs">Location</p>
                  <p className="text-white font-medium">West London, UK</p>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom bar — Minimal but precise */}
